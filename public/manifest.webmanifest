{
  "name": "Neon Sandbox Pro",
  "short_name": "Neon Sandbox",
  "description": "Éditeur de modules email et web, utilisable hors ligne.",
  "lang": "fr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0a12",
  "theme_color": "#0a0a12",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/",
  "shortcuts": [
    {
      "name": "Nouveau module",
      "short_name": "Nouveau",
      "description": "Crée un module vierge et l'ouvre dans l'éditeur",
      "url": "/?action=nouveau",
      "icons": [
        {
          "src": "/shortcut-new.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mes modules",
      "short_name": "Modules",
      "description": "Ta bibliothèque de modules",
      "url": "/",
      "icons": [
        {
          "src": "/shortcut-modules.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Fichiers",
      "short_name": "Fichiers",
      "description": "Tes images et documents",
      "url": "/fichiers",
      "icons": [
        {
          "src": "/shortcut-files.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Mes modules",
      "short_name": "Modules",
      "description": "Tes derniers modules et un accès direct à « Nouveau module ».",
      "tag": "neon-modules",
      "ms_ac_template": "/widgets/modules.json",
      "data": "/api/widget",
      "type": "application/json",
      "auth": false,
      "update": 1800,
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "screenshots": [
        {
          "src": "/widgets/screenshot.png",
          "sizes": "600x400",
          "label": "Le widget Mes modules"
        }
      ]
    }
  ]
}
